@prefix atc: <http://example.org/clinical/atc/> .
@prefix ex: <http://example.org/clinical/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix umls: <http://example.org/clinical/umls/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:aboutClass a rdf:Property ;
    rdfs:domain ex:AllergyRecord ;
    rdfs:range ex:ATCClass .

ex:aboutIngredient a rdf:Property ;
    rdfs:domain ex:AllergyRecord ;
    rdfs:range ex:ActiveIngredient .

ex:aboutPatient a rdf:Property ;
    rdfs:domain ex:Report ;
    rdfs:range ex:Patient .

ex:atcClass a rdf:Property ;
    rdfs:domain ex:ActiveIngredient ;
    rdfs:range ex:ATCClass .

ex:containsIngredient a rdf:Property ;
    rdfs:domain ex:Prescription ;
    rdfs:range ex:ActiveIngredient .

ex:denotes a rdf:Property ;
    rdfs:domain ex:ClinicalMention ;
    rdfs:range ex:UMLSConcept .

ex:derivedFrom a rdf:Property ;
    rdfs:domain ex:ProvenanceBearing ;
    rdfs:range ex:Report .

ex:hasAlert a rdf:Property ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:Alert .

ex:hasAllergyRecord a rdf:Property ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:AllergyRecord .

ex:hasMention a rdf:Property ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:ClinicalMention .

ex:hasPrescription a rdf:Property ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:Prescription .

ex:hasReport a rdf:Property ;
    rdfs:domain ex:Patient ;
    rdfs:range ex:Report .

ex:involvesCondition a rdf:Property ;
    rdfs:domain ex:Alert ;
    rdfs:range ex:ClinicalMention .

ex:involvesDrug a rdf:Property ;
    rdfs:domain ex:Alert ;
    rdfs:range ex:ActiveIngredient .

ex:supportedBy a rdf:Property ;
    rdfs:domain ex:Alert ;
    rdfs:range ex:AllergyRecord .

